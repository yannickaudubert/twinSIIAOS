{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siiaos.local/schemas/execution-plan.schema.json",
  "title": "SIIAOS Execution Plan",
  "type": "object",
  "required": [
    "id",
    "estate_id",
    "workload_id",
    "state",
    "feasibility",
    "steps",
    "cost",
    "gap_analysis",
    "visibility"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 3
    },
    "estate_id": {
      "type": "string",
      "minLength": 3
    },
    "workload_id": {
      "type": "string",
      "minLength": 3
    },
    "state": {
      "type": "string",
      "enum": [
        "candidate",
        "tested",
        "qualified",
        "rejected",
        "superseded"
      ]
    },
    "feasibility": {
      "type": "object",
      "required": [
        "status",
        "basis"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "feasible",
            "conditional",
            "not_feasible",
            "unknown"
          ]
        },
        "basis": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "capability",
          "execution_mode",
          "implementation"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "capability": {
            "type": "string"
          },
          "execution_mode": {
            "type": "string",
            "enum": [
              "deterministic",
              "local_model",
              "local_service",
              "local_agent",
              "human",
              "external_optional",
              "external_required"
            ]
          },
          "resource_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "execution_profile_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "implementation": {
            "type": "string"
          },
          "expected": {
            "type": "object",
            "properties": {
              "ram_mb": {
                "type": "integer",
                "minimum": 0
              },
              "vram_mb": {
                "type": "integer",
                "minimum": 0
              },
              "storage_gb": {
                "type": "number",
                "minimum": 0
              },
              "duration_seconds": {
                "type": "number",
                "minimum": 0
              }
            },
            "additionalProperties": true
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "cost": {
      "type": "object",
      "required": [
        "incremental_eur"
      ],
      "properties": {
        "incremental_eur": {
          "type": "number",
          "minimum": 0
        },
        "external_dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "external_dependencies_required": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "gap_analysis": {
      "type": "object",
      "required": [
        "uncovered_capabilities",
        "substitutions_considered"
      ],
      "properties": {
        "uncovered_capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "substitutions_considered": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rejected_options": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "residual_gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "benchmark_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "local_private",
        "local_shared",
        "client_specific",
        "never_publish"
      ]
    }
  },
  "additionalProperties": false
}
