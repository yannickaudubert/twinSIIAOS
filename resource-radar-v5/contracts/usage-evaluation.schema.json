{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siiaos.local/schemas/usage-evaluation.schema.json",
  "title": "SIIAOS Usage / Perception Evaluation",
  "type": "object",
  "required": [
    "id",
    "persona",
    "journey",
    "observed_at",
    "perception",
    "outcomes",
    "visibility"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 3
    },
    "persona": {
      "type": "string"
    },
    "journey": {
      "type": "string"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "perception": {
      "type": "object",
      "description": "TAT perceptif multidimensionnel. No aggregate score is canonical.",
      "properties": {
        "understanding": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "utility": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "trust": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "openness": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "autonomy": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "humanity": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "risk_perception": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "intention_to_use": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "outcomes": {
      "type": "object",
      "properties": {
        "time_to_understand_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "time_to_useful_action_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "decision_traceable": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "context_fidelity": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "avoidable_detours": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "task_completed": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "visibility": {
      "type": "string",
      "enum": [
        "local_private",
        "local_shared",
        "public_technical",
        "client_specific",
        "never_publish"
      ]
    }
  },
  "additionalProperties": false
}
