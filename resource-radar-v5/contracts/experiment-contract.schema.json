{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siiaos.local/schemas/experiment-contract.schema.json",
  "title": "SIIAOS Experiment Contract",
  "type": "object",
  "required": [
    "id",
    "subject_id",
    "hypothesis",
    "baseline",
    "success_metrics",
    "failure_conditions",
    "resource_budget",
    "rollback",
    "review_required",
    "visibility"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 3
    },
    "subject_id": {
      "type": "string",
      "minLength": 3
    },
    "hypothesis": {
      "type": "string"
    },
    "baseline": {
      "type": "string"
    },
    "success_metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "failure_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "resource_budget": {
      "type": "object",
      "properties": {
        "incremental_eur": {
          "type": "number",
          "minimum": 0
        },
        "max_duration_seconds": {
          "type": "number",
          "minimum": 0
        },
        "max_ram_mb": {
          "type": "integer",
          "minimum": 0
        },
        "max_vram_mb": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "data_scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowed_permissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "test_environment": {
      "type": "string"
    },
    "rollback": {
      "type": "string"
    },
    "evidence_outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review_required": {
      "type": "boolean"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "local_private",
        "local_shared",
        "client_specific",
        "never_publish"
      ]
    }
  },
  "additionalProperties": false
}
