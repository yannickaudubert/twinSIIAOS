{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siiaos.local/schemas/workload.schema.json",
  "title": "SIIAOS Workload",
  "type": "object",
  "required": [
    "id",
    "title",
    "intent",
    "required_capabilities",
    "constraints",
    "visibility"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 3
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "intent": {
      "type": "string",
      "minLength": 1
    },
    "input": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "volume": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "type": "string"
        },
        "estimated_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "corpus_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "required_capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "capability"
        ],
        "properties": {
          "capability": {
            "type": "string"
          },
          "priority": {
            "type": "string",
            "enum": [
              "required",
              "preferred",
              "optional"
            ]
          },
          "quality_floor": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "constraints": {
      "type": "object",
      "required": [
        "incremental_budget_eur"
      ],
      "properties": {
        "incremental_budget_eur": {
          "type": "number",
          "minimum": 0
        },
        "max_duration_seconds": {
          "type": "number",
          "minimum": 0
        },
        "privacy_class": {
          "type": "string"
        },
        "local_only": {
          "type": "boolean"
        },
        "offline_required": {
          "type": "boolean"
        },
        "human_gate": {
          "type": "boolean"
        },
        "allowed_external_providers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "visibility": {
      "type": "string",
      "enum": [
        "local_private",
        "local_shared",
        "client_specific",
        "never_publish"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
