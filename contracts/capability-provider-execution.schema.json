{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://twinsiiaos.example/schemas/capability-provider-execution.schema.json",
  "title": "SIIAOS Capability / Provider / Execution",
  "description": "Front A / A10. Separates governed capabilities from replaceable providers and binds each execution to tenant, mission, authority and evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["providers", "capabilities", "bindings", "execution_envelopes"],
  "properties": {
    "providers": {"type": "array", "items": {"$ref": "#/$defs/provider"}},
    "capabilities": {"type": "array", "items": {"$ref": "#/$defs/capability"}},
    "bindings": {"type": "array", "items": {"$ref": "#/$defs/binding"}},
    "execution_envelopes": {"type": "array", "items": {"$ref": "#/$defs/executionEnvelope"}}
  },
  "$defs": {
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "provider_kind", "status", "replaceable", "execution_modes"],
      "properties": {
        "id": {"type": "string", "pattern": "^provider:[A-Za-z0-9._-]+$"},
        "name": {"type": "string", "minLength": 1},
        "provider_kind": {"enum": ["model_runtime", "agent_runtime", "tool", "workflow", "storage", "search", "document", "human", "other"]},
        "status": {"enum": ["candidate", "available", "degraded", "unavailable", "retired"]},
        "replaceable": {"type": "boolean"},
        "execution_modes": {
          "type": "array",
          "items": {"enum": ["api", "mcp", "cli", "filesystem", "workflow", "library", "native_ui", "human"]},
          "minItems": 1,
          "uniqueItems": true
        },
        "version": {"type": ["string", "null"]},
        "license_ref": {"type": ["string", "null"]},
        "host_refs": {"type": "array", "items": {"type": "string", "pattern": "^host:[A-Za-z0-9._-]+$"}, "uniqueItems": true},
        "evidence_refs": {"type": "array", "items": {"type": "string", "pattern": "^evidence:[A-Za-z0-9._-]+$"}, "uniqueItems": true},
        "exit_strategy_ref": {"type": ["string", "null"]}
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "status", "maturity", "required_evidence_level"],
      "properties": {
        "id": {"type": "string", "pattern": "^capability:[A-Za-z0-9._-]+$"},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": ["string", "null"]},
        "status": {"enum": ["proposed", "admitted", "suspended", "retired"]},
        "maturity": {"enum": ["L0_DISCOVERED", "L1_STAGED", "L2_OPERABLE", "L3_GOVERNED", "L4_RELIABLE", "L5_COMPOSABLE", "L6_MEASURED", "L7_FEDERATED", "L8_PRODUCTION", "L9_SELF_IMPROVING_GOVERNED"]},
        "required_evidence_level": {"enum": ["none", "test", "runtime", "production"]},
        "policy_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "evidence_refs": {"type": "array", "items": {"type": "string", "pattern": "^evidence:[A-Za-z0-9._-]+$"}, "uniqueItems": true}
      },
      "allOf": [
        {
          "if": {"properties": {"maturity": {"const": "L8_PRODUCTION"}}, "required": ["maturity"]},
          "then": {"properties": {"evidence_refs": {"minItems": 1}}, "required": ["evidence_refs"]}
        },
        {
          "if": {"properties": {"maturity": {"const": "L9_SELF_IMPROVING_GOVERNED"}}, "required": ["maturity"]},
          "then": {"properties": {"evidence_refs": {"minItems": 1}}, "required": ["evidence_refs"]}
        }
      ]
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "capability_ref", "provider_ref", "status", "priority", "locality"],
      "properties": {
        "id": {"type": "string", "pattern": "^capability-binding:[A-Za-z0-9._-]+$"},
        "capability_ref": {"type": "string", "pattern": "^capability:[A-Za-z0-9._-]+$"},
        "provider_ref": {"type": "string", "pattern": "^provider:[A-Za-z0-9._-]+$"},
        "status": {"enum": ["candidate", "active", "degraded", "disabled"]},
        "priority": {"type": "integer", "minimum": 0},
        "locality": {"enum": ["local", "remote", "hybrid", "human"]},
        "resource_profile_ref": {"type": ["string", "null"]},
        "policy_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "executionEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "tenant_ref", "mission_ref", "capability_ref", "binding_ref",
        "actor_identity_ref", "mandate_ref", "data_class", "effect_class",
        "status", "created_at"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^execution:[A-Za-z0-9._-]+$"},
        "tenant_ref": {"type": "string", "pattern": "^tenant:[A-Za-z0-9._-]+$"},
        "mission_ref": {"type": "string", "pattern": "^mission:[A-Za-z0-9._-]+$"},
        "capability_ref": {"type": "string", "pattern": "^capability:[A-Za-z0-9._-]+$"},
        "binding_ref": {"type": "string", "pattern": "^capability-binding:[A-Za-z0-9._-]+$"},
        "actor_identity_ref": {"type": "string", "pattern": "^identity:[A-Za-z0-9._-]+$"},
        "mandate_ref": {"type": "string", "pattern": "^mandate:[A-Za-z0-9._-]+$"},
        "toolgrant_ref": {"type": ["string", "null"]},
        "human_gate_ref": {"type": ["string", "null"]},
        "data_class": {"enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "RESTRICTED"]},
        "effect_class": {"enum": ["read", "local_reversible", "external_compensable", "irreversible"]},
        "status": {"enum": ["planned", "allowed", "blocked", "waiting_human", "running", "succeeded", "failed", "cancelled"]},
        "input_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "output_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "evidence_refs": {"type": "array", "items": {"type": "string", "pattern": "^evidence:[A-Za-z0-9._-]+$"}, "uniqueItems": true},
        "created_at": {"type": "string", "format": "date-time"}
      },
      "allOf": [
        {
          "if": {"properties": {"effect_class": {"const": "irreversible"}}, "required": ["effect_class"]},
          "then": {"properties": {"human_gate_ref": {"type": "string", "pattern": "^humangate:[A-Za-z0-9._-]+$"}}, "required": ["human_gate_ref"]}
        }
      ]
    }
  }
}