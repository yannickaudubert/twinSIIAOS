{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siiaos.local/schemas/building-projection-v1.schema.json",
  "title": "SIIAOS Building Projection v1",
  "type": "object",
  "required": ["schema_version", "building_id", "name", "kind", "implementation_status", "floors"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "building_id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "kind": {"enum": ["hall", "consulting", "dsi", "radar", "knowledge", "communications", "revenue"]},
    "implementation_status": {"enum": ["DESIGNED", "CODED", "TESTED", "DEPLOYED", "OBSERVED"]},
    "desired_state": {"type": "string"},
    "observed_state": {"type": "string"},
    "canonical_refs": {"type": "array", "items": {"type": "string"}},
    "entrypoints": {"type": "array", "items": {"type": "string"}},
    "floors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["floor_id", "name", "purpose", "service_cells"],
        "properties": {
          "floor_id": {"type": "string"},
          "name": {"type": "string"},
          "purpose": {"type": "string"},
          "service_cells": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["cell_id", "name", "capability_refs"],
              "properties": {
                "cell_id": {"type": "string"},
                "name": {"type": "string"},
                "capability_refs": {"type": "array", "items": {"type": "string"}},
                "team_templates": {"type": "array", "items": {"type": "string"}},
                "tool_refs": {"type": "array", "items": {"type": "string"}},
                "human_gate": {"type": "boolean"},
                "interaction": {"type": "string"}
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    },
    "handoffs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "authorization"],
        "properties": {
          "from": {"type": "string"},
          "to": {"type": "string"},
          "authorization": {"type": "string"}
        }
      }
    }
  },
  "additionalProperties": true
}
